@page
@model LogoutModel

@{
    ViewData["Title"] = "Odjava";
}

<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/termini.css" asp-append-version="true" />

<div class="auth-page">
    <div class="auth-card">

        <div class="auth-logo">👋</div>

        <h1 class="auth-title">Odjava</h1>

        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <p class="auth-subtitle">
                Da li ste sigurni da se želite odjaviti sa svog računa?
            </p>

            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Page("/", new { area = "" })"
                  method="post">

                <button type="submit" class="auth-btn">
                    Odjavi me
                </button>

            </form>
        }
        else
        {
            <p class="logout-success">
                ✅ Uspješno ste se odjavili iz aplikacije.
            </p>

            <div class="auth-links">
                <a asp-controller="Home" asp-action="Index">
                    Povratak na početnu stranicu
                </a>
            </div>
        }

    </div>
</div>