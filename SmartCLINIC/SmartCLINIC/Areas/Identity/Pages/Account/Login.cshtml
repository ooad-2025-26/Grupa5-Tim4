@page
@model LoginModel

@{
    ViewData["Title"] = "Prijava";
}

<div class="auth-page">
    <div class="auth-card">

        <div class="auth-logo">🏥</div>

        <h1 class="auth-title">Prijava</h1>
        <p class="auth-subtitle">Dobrodošli nazad u SmartClinic</p>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                <label asp-for="Input.Email">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="password" />
                <label asp-for="Input.Password">Lozinka</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="auth-checkbox mb-3">
                <label asp-for="Input.RememberMe">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    Zapamti me
                </label>
            </div>

            <button id="login-submit" type="submit" class="auth-btn">
                Prijavi se
            </button>

            <div class="auth-links">
                <p>
                    <a id="forgot-password" asp-page="./ForgotPassword">Zaboravili ste lozinku?</a>
                </p>
                <p>
                    Nemate račun?
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Registrujte se</a>
                </p>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}