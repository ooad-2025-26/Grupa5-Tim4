@model SmartClinic.Models.Termin

@{
    ViewData["Title"] = "Detalji termina";
}

<link rel="stylesheet" href="~/css/termini.css" asp-append-version="true" />

<div class="appointment-page">
    <div class="appointment-card">

        <h1>Detalji termina</h1>

        <div class="details-container">

            <div class="details-row">
                <strong>Pacijent:</strong>
                @Model.Pacijent?.Ime @Model.Pacijent?.Prezime
            </div>

            <div class="details-row">
                <strong>Email:</strong>
                @Model.Pacijent?.Email
            </div>

            <div class="details-row">
                <strong>Doktor:</strong>
                @Model.Doktor?.Ime @Model.Doktor?.Prezime
            </div>

            <div class="details-row">
                <strong>Usluga:</strong>
                @Model.UslugaKlinike?.Naziv
            </div>

            <div class="details-row">
                <strong>Datum:</strong>
                @Model.Datum.ToString("dd.MM.yyyy")
            </div>

            <div class="details-row">
                <strong>Vrijeme:</strong>
                @Model.Vrijeme
            </div>

            <div class="details-row">
                <strong>Status:</strong>
                @Model.Status
            </div>

        </div>

        <div class="page-actions">
            <a asp-action="Edit"
               asp-route-id="@Model.TerminId"
               class="admin-btn edit-btn">
                Uredi
            </a>

            <a asp-action="Index"
               class="back-btn">
                Nazad
            </a>
        </div>

    </div>
</div>