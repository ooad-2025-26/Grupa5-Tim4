@model SmartClinic.Models.Termin

@{
    ViewData["Title"] = "Uredi termin";
}

<link rel="stylesheet" href="~/css/termini.css" asp-append-version="true" />

<div class="appointment-page">
    <div class="appointment-card">

        <h1>Uredi termin</h1>

        <form asp-action="Edit" class="edit-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="TerminId" />

            <div class="form-group">
                <label asp-for="Datum">Datum</label>
                <input asp-for="Datum" class="form-control" />
                <span asp-validation-for="Datum" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Vrijeme">Vrijeme</label>
                <input asp-for="Vrijeme" class="form-control" />
                <span asp-validation-for="Vrijeme" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Status">Status</label>
                <select asp-for="Status" class="form-control">
                    <option value="Zakazan">Zakazan</option>
                    <option value="Otkazan">Otkazan</option>
                    <option value="Završen">Završen</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PacijentId">Pacijent</label>
                <select asp-for="PacijentId"
                        class="form-control"
                        asp-items="ViewBag.PacijentId">
                </select>
                <span asp-validation-for="PacijentId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DoktorId">Doktor</label>
                <select asp-for="DoktorId"
                        class="form-control"
                        asp-items="ViewBag.DoktorId">
                </select>
                <span asp-validation-for="DoktorId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UslugaId">Usluga</label>
                <select asp-for="UslugaId"
                        class="form-control"
                        asp-items="ViewBag.UslugaId">
                </select>
                <span asp-validation-for="UslugaId" class="text-danger"></span>
            </div>

            <div class="page-actions">
                <button type="submit" class="confirm-btn">
                    Sačuvaj izmjene
                </button>

                <a asp-action="Index" class="back-btn">
                    Nazad
                </a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}