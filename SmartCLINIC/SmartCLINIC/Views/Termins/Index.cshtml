@model IEnumerable<SmartClinic.Models.Termin>

@{
    ViewData["Title"] = "Svi termini";
}

<link rel="stylesheet" href="~/css/termini.css" asp-append-version="true" />

<div class="appointment-page">
    <div class="appointment-card">

        <h1>Svi termini</h1>
        <div style="margin-bottom:25px;">
            <a asp-action="SkenirajQR"
               class="admin-btn edit-btn">
                📷 Skeniraj QR kod
            </a>
        </div>

        @if (!Model.Any())
        {
            <p>Trenutno nema zakazanih termina.</p>
        }
        else
        {
            <div class="table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Pacijent</th>
                        <th>Doktor</th>
                        <th>Usluga</th>
                        <th>Datum</th>
                        <th>Vrijeme</th>
                        <th>Status</th>
                        <th>Akcije</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var termin in Model)
                    {
                        <tr>
                            <td>@termin.Pacijent?.Ime @termin.Pacijent?.Prezime</td>
                            <td>@termin.Doktor?.Ime @termin.Doktor?.Prezime</td>
                            <td>@termin.UslugaKlinike?.Naziv</td>
                            <td>@termin.Datum.ToString("dd.MM.yyyy")</td>
                            <td>@termin.Vrijeme</td>
                            <td>@termin.Status</td>

                            <td class="admin-actions">
                                <a asp-action="Details"
                                   asp-route-id="@termin.TerminId"
                                   class="admin-btn details-btn">
                                    Detalji
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@termin.TerminId"
                                   class="admin-btn edit-btn">
                                    Uredi
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }

    </div>
</div>